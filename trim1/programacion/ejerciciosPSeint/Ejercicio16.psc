Proceso Ejercicio16
	//Calcular el área de un rectángulo de lados X e Y.
	
	//DEFINCION DE VARIABLES
	Definir lado1 Como Real;
	Definir lado2 Como Real;
	Definir area Como Real;
	//ENTRADA
	Escribir "lado x";
	Leer lado1;
	Escribir "lado y";
	Leer lado2;
	//PROCESO
	area <- lado1*lado2;
	//SALIDA
	Escribir "Área: ",area;
	
FinProceso
