Algoritmo Ejercicio7
	//Hacer un algoritmo para sumar dos números, los cuales serán tecleados por el usuario. Mostrar el
	//resultado
	
	//DEFINICIÓN DE VARIABLES
	Definir num1 como Entero;
	Definir num2 Como Entero;
	Definir suma como Entero;
	//ENTRADA
	Escribir "Ingrese dos números para sumarlos";
	Leer num1,num2;
	//PROCESO 
	suma <- num1+num2;
	//SALIDA
	Escribir "El resultado de sumar el número ",num1," y el número ",num2," es ",suma;
FinAlgoritmo
