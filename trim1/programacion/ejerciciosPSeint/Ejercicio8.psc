Algoritmo Ejercicio8
	//Hacer un algoritmo que lea el nombre de una persona y número de horas que estudia en la semana
	
	//DEFINICIÓN DE VARIABLES
	Definir nombre como Cadena;
	Definir horasDeEstudio Como Real;
	//ENTRADA
	Escribir "Ingrese su nombre";
	Leer nombre;
	Escribir "Ingrese el número de horas a la sema que estudia";
	Leer horasDeEstudio;
	//SALIDA
	Escribir "Su nombre es ",nombre," y la cantidad de horas que estudia es ",horasDeEstudio;
FinAlgoritmo
