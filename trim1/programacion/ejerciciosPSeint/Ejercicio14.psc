Proceso Ejercicio14
	//Pedir el radio de una circunferencia y calcular su longitud
	
	//DEFINICION DE VARIABLES
	Definir radio Como Real;
	Definir longitudCirculo Como Real;
	definir numPi Como Real;
	//ENTRADA
	Escribir "Ingrese el radio del círculo para calcular su longitud";
	Leer radio;
	//PROCESO
	numPi <- 3.14159;
	longitudCirculo <- numPi * (2*radio);
	//SALIDA
	Escribir "La longitud del circulo es ",longitudCirculo;
FinProceso
