Algoritmo Ejercicio9
	//Hacer un algoritmo que lea el nombre de un estudiante, la cantidad de materias perdidas y la cantidad
	//de materias ganadas
	
	//DEFINICIÓN DE VARIABLES
	Definir nombre como Cadena;
	Definir materiasPerdidas Como Entero;
	Definir materiasGanadas Como Entero;
	//ENTRADA
	Escribir "Ingrese el nombre del estudiante, la cantidad de materias perdidas y la cantidad de materias ganadas";
	Leer nombre,materiasPerdidas,materiasGanadas;
	//SALIDA
	Escribir "El nombre del estudiante es ",nombre;
	Escribir "La cantidad de materias perdidas es ",materiasPerdidas;
	Escribir "la cantidad de materias ganadas es ",materiasGanadas;
FinAlgoritmo
