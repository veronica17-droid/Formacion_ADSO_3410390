Algoritmo Ejercicio3
	//Hacer un algoritmo que declare una variable para guardar el promedio del semestre, otra para guardar
	//el nombre de un estudiante y otra para guardar el número de notas perdidas
	
	//DEFINICIÓN DE VARIABLES
	Definir nombre Como Cadena;
	Definir promedio Como Real;
	Definir notasPerdidas Como Real;
	//ENTRADA
	Escribir "Ingrese el nombre del estudiante, su promedio y el número de notas perdidas";
	Leer nombre,promedio,notasPerdidas;
	//SALIDA
	Escribir "El nombre del estudiante es ",nombre," su promedio es ",promedio," y el número de notas perdidas es ",notasPerdidas;
FinAlgoritmo
