Algoritmo Ejercicio4
	//Hacer un algoritmo que lea dos números enteros A y B y muestre el resultado de realizar: (A + B) *2
	//+10
	
	//DEFINICION DE VARIABLES
	Definir a Como Real;
	Definir b Como Real;
	Definir resultado Como Real;
	//ENTRADA
	Escribir "Ingrese dos números para aplicarles la formula (A + B) *2+10";
	Leer a,b;
	//PROCESO
	resultado <- (a+b)*2+10;
	//SALIDA 
	Escribir "El resultado de aplicarle la formula (A + B) *2+10 al número ",a," y al número ",b," es ",resultado;
FinAlgoritmo
