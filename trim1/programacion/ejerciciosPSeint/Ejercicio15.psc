Proceso Ejercicio15
	//Pedir el lado de un cuadrado, mostrar su área y su perímetro
	
	//DEFINICION DE VARIABLES
	Definir lado Como Real;
	Definir area Como Real;
	definir perimetro Como Real;
	//ENTRADA
	Escribir "Ingrese el lado del cuadrado";
	Leer lado;
	//PROCESO 
	area <- lado*lado;
	perimetro <- lado*4;
	//SALIDA
	Escribir "El área del cuadrado es ",area," y su perimetro es ",perimetro;
FinProceso
