Algoritmo Ejercicio2
	//Hacer un algoritmo que lea dos números enteros A y B y muestre el doble de su suma
	//DEFINICIÓN DE VARIABLES
	Definir num1 Como Real;
	Definir num2 Como Numerica
	Definir resultado Como Real;
	//ENTRADA
	Escribir "Ingrese dos números para mostrar el doble de su suma";
	Leer num1;
	Leer num2;
	//PROCESO
	resultado <- 2*(num1+num2);
	//SALIDA
	Escribir "El doble de la suma entre el número ",num1," y el número ",num2," es ",resultado;
FinAlgoritmo
