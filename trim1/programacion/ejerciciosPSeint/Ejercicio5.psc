Algoritmo Ejercicio5
	//Hacer un algoritmo que declare una variable para guardar el nombre de una persona, otra para
	//guardar la comida preferida y otra para guardar la cantidad de dinero que posee.
	
	//DEFINICION DE VARIABLES
	Definir nombre Como Cadena;
	Definir comidaPreferida Como Cadena;
	Definir dineroQuePosee Como Real;
	//ENTRADA
	Escribir "Ingrese el nombre de la persona, su comida preferida y la cantidad de dinero que posee";
	Leer nombre,comidaPreferida,dineroQuePosee;
	//SALIDA 
	Escribir "El nombre de la persona es ",nombre," su comida preferida es ",comidaPreferida," y la cantidad de dinero que posee es ",dineroQuePosee;
FinAlgoritmo
