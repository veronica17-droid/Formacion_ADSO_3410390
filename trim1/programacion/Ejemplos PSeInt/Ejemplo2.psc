Algoritmo Ejemplo2
	//Angie Verónica carvajal
	//ej2. Realizar un Algoritmo que defina una variable para guardar la cantidad de aprendices
	//la estatura promedio del grupo y el progama de formación
	//Mostrar en pantalla los datos asignados
	
	//DEFINICIÓN DE VARIABLES
	Definir cantAprendices Como Entero;
	Definir promedioEstatura Como Real;
	Definir programaFormacion Como Cadena;
	
	//INICIALIZACION DE VARIABLES
	cantAprendices <- 30;
	promedioEstatura <- 1.65;
	programaFormacion <- "Análisis y desrrollo de software";
	
	//SALIDA Algoritmo 
	Escribir "La cantidad de aprendices es: " ,cantAprendices;
	Escribir "El promedio de estatura es: ",promedioEstatura;
	Escribir "El programa de formación es: ",programaFormacion;
	
FinAlgoritmo
