Algoritmo Ejemplo3
	//Angie Verónica carvajal
	//Solicitar al usuario los siguientes datos personales: Nombre, peso, edad y años de experiencia.
	//Mostrar al final el consolidado
	
	//ENTRADA
	//DEFINICIÓN DE VARIABLES
	Definir nombre Como Cadena;
	Definir peso Como Real;
	Definir edad Como Entero;
	Definir anosExperiencia Como Entero; 
	
	Escribir "Ingrese su nombre";
	Leer nombre;
	Escribir "Ingrese su peso";
	Leer peso;
	Escribir "Ingrese su edad";
	Leer edad;
	Escribir "Ingrese sus años de experiencia";
	Leer anosExperiencia;
	
	//SALIDA Algoritmo 
	Escribir "Su nombre es ",nombre,", pesa ",peso," kilos y tiene ",edad," años ";
	Escribir "Tienes una experiencia de ",anosExperiencia," años";
	
FinAlgoritmo
