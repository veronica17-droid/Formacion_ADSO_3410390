Algoritmo areaAmbienteDeFormacion
	//Angie verónica carvajal cardona
	//CALCULAR ÁREA DE SISTEMAS 1
	//DEFINICIÓN DE VARIABLES
	Definir largo Como Real;
	Definir ancho Como Real;
	Definir area Como Real;
	//ENTRADA
	Escribir "Ingrese el largo del ambiente";
	Leer largo;
	Escribir "Ingrese el ancho del ambiente";
	Leer ancho;
	//PROCESO
	area <- largo*ancho;
	//SALIDA
	Escribir "El área del ambiente es ",area;
FinAlgoritmo