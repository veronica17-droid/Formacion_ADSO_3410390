Algoritmo Ejemplo4
	//Angie Verónica carvajal
	//Solicitar al usuario 3 numeros y mostrar el promedio de ellos
	//Mostrar en pantalla el promedio de todos
	
	//ENTRADA
	//DEFINICIÓN DE VARIABLES
	Definir num1 Como Entero;
	Definir num2 Como Entero;
	Definir num3 Como Entero;
	Definir promedio como Real;
	
	Escribir "Ingrese numero 1";
	Leer num1;
	Escribir "Ingrese numero 2";
	Leer num2;
	Escribir "Ingrese numero 3";
	Leer num3;
	
	//PROCESO
	promedio <- (num1+num2+num3)/3;
	
	//SALIDA Algoritmo 
	Escribir "El promedio de los números ", num1,", " ,num2," y " ,num3 ," es ",promedio;
	
FinAlgoritmo
